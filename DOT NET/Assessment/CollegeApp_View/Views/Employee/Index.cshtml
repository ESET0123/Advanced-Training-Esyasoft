@{
    ViewData["Title"] = "employees";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-people"></i> Employee List</h2>
        <button id="addemployeeBtn" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Add Employee
        </button>
    </div>

    <div class="card shadow-lg p-4">
        <div class="d-flex justify-content-between mb-3">
            <button id="loadBtn" class="btn btn-primary">
                <i class="bi bi-arrow-clockwise"></i> Load Employees
            </button>
        </div>

        <div id="employees" class="table-responsive"></div>
    </div>
</div>

<!-- Modal for Add/Edit -->
<div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="employeeModalLabel">Add / Edit Employee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="employeeForm">
                    <input type="hidden" id="employeeId" />
                    <div class="mb-3">
                        <label for="Name" class="form-label fw-semibold">Full Name</label>
                        <input type="text" id="Name" class="form-control" placeholder="Enter Full Name" required />
                    </div>
                    <div class="mb-3">
                        <label for="Department" class="form-label fw-semibold">Department</label>
                        <input type="text" id="Department" class="form-control" placeholder="Enter Department" required />
                    </div>
                    <div class="mb-3">
                        <label for="Salary" class="form-label fw-semibold">Salary</label>
                        <input type="number" id="Salary" class="form-control" placeholder="Enter Salary" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label for="Email" class="form-label fw-semibold">Email</label>
                        <input type="email" id="Email" class="form-control" placeholder="Enter Email" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- jQuery + Bootstrap JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let employeesData = [];

    // Load employees
    $("#loadBtn").click(function () {
        const token = localStorage.getItem("jwtToken");

        if (!token) {
            alert("Please login first!");
            window.location.href = "/Auth/Login";
            return;
        }

        $.ajax({
            url: "https://localhost:7195/api/Employee/All",
            type: "GET",
            headers: { "Authorization": "Bearer " + token },
            success: function (data) {
                employeesData = data;
                renderTable(data);
            },
            error: function (xhr) {
                if (xhr.status === 401) {
                    $("#employees").html("<p class='text-danger'>Unauthorized. Please login again.</p>");
                } else {
                    $("#employees").html("<p class='text-danger'>Error fetching data.</p>");
                }
            }
        });
    });

    // Render Bootstrap Table
    function renderTable(data) {
        let html = `
            <table class='table table-hover align-middle text-center'>
                <thead class='table-dark'>
                    <tr>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Salary</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
        `;

        data.forEach(s => {
            html += `
                <tr>
                    <td>${s.fullName}</td>
                    <td>${s.department}</td>
                    <td>$${parseFloat(s.salary).toFixed(2)}</td>
                    <td>${s.email || 'N/A'}</td>
                    <td>
                        <button class='btn btn-warning btn-sm me-2 editBtn' data-id='${s.employeeId}'>
                            <i class='bi bi-pencil-square'></i> Edit
                        </button>
                        <button class='btn btn-danger btn-sm deleteBtn' data-id='${s.employeeId}'>
                            <i class='bi bi-trash'></i> Delete
                        </button>
                    </td>
                </tr>
            `;
        });

        html += "</tbody></table>";
        $("#employees").html(html);
    }

    // Open Modal for Add
    $("#addemployeeBtn").click(function () {
        $("#employeeForm")[0].reset();
        $("#employeeId").val('');
        $("#employeeModalLabel").text("Add Employee");
        $("#employeeModal").modal("show");
    });

    // Open Modal for Edit
    $(document).on("click", ".editBtn", function () {
        const id = $(this).data("id");
        const employee = employeesData.find(s => s.employeeId === id);

        if (employee) {
            $("#employeeId").val(employee.employeeId);
            $("#Name").val(employee.fullName);
            $("#Department").val(employee.department);
            $("#Salary").val(employee.salary);
            $("#Email").val(employee.email || '');
            $("#employeeModalLabel").text("Edit Employee");
            $("#employeeModal").modal("show");
        }
    });

    // Delete Employee
    $(document).on("click", ".deleteBtn", function () {
        const id = $(this).data("id");
        const employee = employeesData.find(s => s.employeeId === id);

        if (!employee) return;

        if (confirm(`Are you sure you want to delete ${employee.fullName}?`)) {
            const token = localStorage.getItem("jwtToken");

            if (!token) {
                alert("Please login first!");
                window.location.href = "/Auth/Login";
                return;
            }

            $.ajax({
                url: `https://localhost:7195/api/Employee?id=${id}`,
                type: "DELETE",
                headers: { "Authorization": "Bearer " + token },
                success: function () {
                    alert("Employee deleted successfully!");
                    $("#loadBtn").click();
                },
                error: function (xhr) {
                    alert("Error deleting employee: " + (xhr.responseText || "Unknown error"));
                }
            });
        }
    });

    // Submit Form (Add or Edit)
    $("#employeeForm").submit(function (e) {
        e.preventDefault();

        const token = localStorage.getItem("jwtToken");

        if (!token) {
            alert("Please login first!");
            window.location.href = "/Auth/Login";
            return;
        }

        const employee = {
            employeeId: parseInt($("#employeeId").val()) || 0,
            fullName: $("#Name").val(),
            department: $("#Department").val(),
            salary: parseFloat($("#Salary").val()),
            email: $("#Email").val() || null
        };

        const isEdit = employee.employeeId > 0;

        const apiUrl = isEdit
            ? "https://localhost:7195/api/Employee/Update"
            : "https://localhost:7195/api/Employee/Create";

        $.ajax({
            url: apiUrl,
            type: isEdit ? "PUT" : "POST",
            headers: { "Authorization": "Bearer " + token },
            contentType: "application/json",
            data: JSON.stringify(employee),
            success: function () {
                $("#employeeModal").modal("hide");
                $("#loadBtn").click();
                alert(isEdit ? "Employee updated successfully!" : "Employee added successfully!");
            },
            error: function (xhr) {
                alert("Error saving employee: " + (xhr.responseText || "Unknown error"));
            }
        });
    });
</script>